# Sao chép file này thành .env rồi điền API key
# Lấy key tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model chính dùng để trả lời (xem danh sách tại GET /api/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Model nhỏ/nhanh dùng cho viết lại câu hỏi, trích xuất JSON
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Nhiệt độ sinh văn bản (0.0 - 1.0). Tra cứu luật nên để thấp.
TEMPERATURE=0.15
MAX_TOKENS=2048

# ---- RAG ----
# auto | sentence-transformers | tfidf | none
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNK_MAX_CHARS=1600
CHUNK_OVERLAP=200
TOP_K=6
CANDIDATE_K=30

# ---- Server ----
HOST=127.0.0.1
PORT=8000

# ---- Tài khoản & đăng nhập ----
# Số ngày giữ phiên khi người dùng tích "Ghi nhớ đăng nhập".
SESSION_TTL_DAYS=30

# true  = ai cũng tự đăng ký được (hợp cho máy cá nhân / mạng nội bộ)
# false = chỉ quản trị viên mới tạo được tài khoản. NÊN ĐỂ false khi mở ra Internet.
# Lưu ý: khi CSDL còn trống thì lần đăng ký ĐẦU TIÊN luôn được phép và người đó
# trở thành quản trị viên — nên đặt false ngay từ đầu vẫn lập được admin.
ALLOW_REGISTRATION=true

# Cookie phiên: auto = tự bật cờ Secure khi chạy trên HTTPS (để nguyên là được).
COOKIE_SECURE=auto

# Tạo sẵn tài khoản quản trị khi CSDL còn trống. Bỏ trống ADMIN_PASSWORD thì
# bỏ qua bước này và người đăng ký đầu tiên sẽ là quản trị viên.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
