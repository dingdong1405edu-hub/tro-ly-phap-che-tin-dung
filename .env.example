# Sao chép file này thành .env rồi điền API key
# Lấy key tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model chính dùng để trả lời (xem danh sách tại GET /api/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Model nhỏ/nhanh dùng cho viết lại câu hỏi, trích xuất JSON
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Nhiệt độ sinh văn bản (0.0 - 1.0). Tra cứu luật nên để thấp.
TEMPERATURE=0.15
MAX_TOKENS=2048

# ---- RAG ----
# auto | sentence-transformers | tfidf | none
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNK_MAX_CHARS=1600
CHUNK_OVERLAP=200
TOP_K=6
CANDIDATE_K=30

# ---- Server ----
HOST=127.0.0.1
PORT=8000
